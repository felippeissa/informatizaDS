{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Informatiza Design System 3.1 — HTML + CSS, Bootstrap 5 (base Inspinia). Em código, prefira as variáveis CSS do tema (nome no $description) aos valores fixos.",
  "color": {
    "primary": { "$type": "color", "$value": "#1ab394", "$description": "--theme-primary" },
    "secondary": { "$type": "color", "$value": "#1c84c6", "$description": "--theme-secondary" },
    "success": { "$type": "color", "$value": "#0acf97", "$description": "--theme-success" },
    "info": { "$type": "color", "$value": "#23c6c8", "$description": "--theme-info" },
    "warning": { "$type": "color", "$value": "#f8ac59", "$description": "--theme-warning" },
    "danger": { "$type": "color", "$value": "#ed5565", "$description": "--theme-danger" },
    "purple": { "$type": "color", "$value": "#7b70ef", "$description": "--theme-purple" },
    "light": { "$type": "color", "$value": "#eef2f7", "$description": "--theme-light" },
    "dark": { "$type": "color", "$value": "#313a46", "$description": "--theme-dark" },
    "body-bg": { "$type": "color", "$value": "#f1f2f7", "$description": "--theme-body-bg — fundo da página" },
    "card-bg": { "$type": "color", "$value": "#ffffff", "$description": "--theme-secondary-bg — fundo de cards" },
    "tertiary-bg": { "$type": "color", "$value": "#f6f7fb", "$description": "--theme-tertiary-bg" },
    "text": { "$type": "color", "$value": "#4c4c5c", "$description": "--theme-body-color" },
    "text-secondary": { "$type": "color", "$value": "#9ba6b7", "$description": "--theme-secondary-color" },
    "border": { "$type": "color", "$value": "#e7e9eb", "$description": "--theme-border-color" },
    "gray": {
      "100": { "$type": "color", "$value": "#f6f7fb" },
      "200": { "$type": "color", "$value": "#eef2f7" },
      "300": { "$type": "color", "$value": "#e7e9eb" },
      "400": { "$type": "color", "$value": "#ced4da" },
      "500": { "$type": "color", "$value": "#a1a9b1" },
      "600": { "$type": "color", "$value": "#8a969c" },
      "700": { "$type": "color", "$value": "#6c757d" },
      "800": { "$type": "color", "$value": "#343a40" },
      "900": { "$type": "color", "$value": "#313a46" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Open Sans", "sans-serif"], "$description": "--theme-font-sans-serif" },
    "size": {
      "xxs": { "$type": "dimension", "$value": "11px" },
      "xs": { "$type": "dimension", "$value": "12px" },
      "base": { "$type": "dimension", "$value": "13px", "$description": "--theme-font-size-base" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "15px" },
      "lg": { "$type": "dimension", "$value": "16px" },
      "xl": { "$type": "dimension", "$value": "18px" },
      "xxl": { "$type": "dimension", "$value": "20px" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "line-height": { "$type": "number", "$value": 1.5 }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.25rem", "$description": "--theme-border-radius-sm" },
    "base": { "$type": "dimension", "$value": "0.3rem", "$description": "--theme-border-radius" },
    "lg": { "$type": "dimension", "$value": "0.4rem", "$description": "--theme-border-radius-lg" },
    "xl": { "$type": "dimension", "$value": "1rem", "$description": "--theme-border-radius-xl" }
  },
  "shadow": {
    "base": { "$type": "shadow", "$value": "0px 1px 4px 0px rgba(130, 143, 163, 0.15)", "$description": "--theme-box-shadow" }
  },
  "layout": {
    "sidenav-width": { "$type": "dimension", "$value": "235px", "$description": "--theme-sidenav-width" },
    "sidenav-width-compact": { "$type": "dimension", "$value": "75px", "$description": "--theme-sidenav-width-sm" },
    "topbar-height": { "$type": "dimension", "$value": "65px", "$description": "--theme-topbar-height" },
    "gutter": { "$type": "dimension", "$value": "1.25rem", "$description": "--theme-gutter-x" }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "576px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "992px" },
    "xl": { "$type": "dimension", "$value": "1200px" },
    "xxl": { "$type": "dimension", "$value": "1400px" }
  },
  "icon": {
    "library": { "$type": "other", "$value": "Tabler Icons", "$description": "Classe: ti ti-<nome>" }
  }
}
