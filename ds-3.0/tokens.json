{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Informatiza Design System 3.0 — Angular 21 + PrimeNG 21 (preset Aura, primária emerald). Em código, prefira as variáveis CSS do tema (campo cssVar) aos valores fixos.",
  "color": {
    "primary": {
      "50": { "$type": "color", "$value": "#ecfdf5" },
      "100": { "$type": "color", "$value": "#d1fae5" },
      "200": { "$type": "color", "$value": "#a7f3d0" },
      "300": { "$type": "color", "$value": "#6ee7b7" },
      "400": { "$type": "color", "$value": "#34d399" },
      "500": { "$type": "color", "$value": "#10b981", "$description": "Cor primária (cssVar: --primary-color / --p-primary-color)" },
      "600": { "$type": "color", "$value": "#059669" },
      "700": { "$type": "color", "$value": "#047857" },
      "800": { "$type": "color", "$value": "#065f46" },
      "900": { "$type": "color", "$value": "#064e3b" },
      "950": { "$type": "color", "$value": "#022c22" }
    },
    "surface": {
      "0": { "$type": "color", "$value": "#ffffff", "$description": "Fundo de card (cssVar: --surface-card)" },
      "50": { "$type": "color", "$value": "#f8fafc" },
      "100": { "$type": "color", "$value": "#f1f5f9", "$description": "Fundo da página (cssVar: --surface-ground)" },
      "200": { "$type": "color", "$value": "#e2e8f0", "$description": "Bordas (cssVar: --surface-border)" },
      "300": { "$type": "color", "$value": "#cbd5e1" },
      "400": { "$type": "color", "$value": "#94a3b8" },
      "500": { "$type": "color", "$value": "#64748b", "$description": "Texto secundário (cssVar: --text-color-secondary)" },
      "600": { "$type": "color", "$value": "#475569" },
      "700": { "$type": "color", "$value": "#334155", "$description": "Texto (cssVar: --text-color)" },
      "800": { "$type": "color", "$value": "#1e293b" },
      "900": { "$type": "color", "$value": "#0f172a" },
      "950": { "$type": "color", "$value": "#020617" }
    },
    "severity": {
      "success": { "$type": "color", "$value": "#22c55e", "$description": "severity=\"success\" — ativo, concluído" },
      "info": { "$type": "color", "$value": "#0ea5e9", "$description": "severity=\"info\"" },
      "warn": { "$type": "color", "$value": "#f97316", "$description": "severity=\"warn\" — pendente, atenção" },
      "danger": { "$type": "color", "$value": "#ef4444", "$description": "severity=\"danger\" — inativo, erro, exclusão" },
      "secondary": { "$type": "color", "$value": "#64748b", "$description": "severity=\"secondary\" — neutro" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Inter var", "Inter", "sans-serif"] },
    "size": {
      "page-title": { "$type": "dimension", "$value": "1.5rem" },
      "card-title": { "$type": "dimension", "$value": "1rem" },
      "body": { "$type": "dimension", "$value": "1rem" },
      "label": { "$type": "dimension", "$value": "0.8125rem" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "space": {
    "page-padding": { "$type": "dimension", "$value": "1.5rem" },
    "section-gap": { "$type": "dimension", "$value": "1rem" },
    "card-padding": { "$type": "dimension", "$value": "1.5rem" },
    "field-gap": { "$type": "dimension", "$value": "0.4rem" }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "12px" },
    "control": { "$type": "dimension", "$value": "6px", "$description": "Raio padrão dos inputs/botões do preset Aura" }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": "0 1px 4px rgba(0, 0, 0, 0.04)" }
  },
  "icon": {
    "library": { "$type": "other", "$value": "PrimeIcons", "$description": "Classe: pi pi-<nome>" }
  }
}
