{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Informatiza Design System 3.0 — Angular 21 + PrimeNG 21 (preset Aura, primária emerald). Raiz da página = 14px (1rem = 14px). Em código, prefira as variáveis CSS do tema (indicadas em $description) aos valores fixos. Documentação visual em /ds/foundations.",
  "color": {
    "semantic": {
      "primary": { "$type": "color", "$value": "{color.primary.500}", "$description": "var(--primary-color) — ações principais, links, item ativo, foco" },
      "page-bg": { "$type": "color", "$value": "{color.surface.100}", "$description": "var(--surface-ground) — fundo da página" },
      "card-bg": { "$type": "color", "$value": "{color.surface.0}", "$description": "var(--surface-card) — cards, painéis, modais" },
      "border": { "$type": "color", "$value": "{color.surface.200}", "$description": "var(--surface-border)" },
      "hover": { "$type": "color", "$value": "{color.surface.100}", "$description": "var(--surface-hover)" },
      "text": { "$type": "color", "$value": "{color.surface.700}", "$description": "var(--text-color)" },
      "text-secondary": { "$type": "color", "$value": "{color.surface.500}", "$description": "var(--text-color-secondary)" }
    },
    "primary": {
      "50": { "$type": "color", "$value": "#ecfdf5" },
      "100": { "$type": "color", "$value": "#d1fae5" },
      "200": { "$type": "color", "$value": "#a7f3d0" },
      "300": { "$type": "color", "$value": "#6ee7b7" },
      "400": { "$type": "color", "$value": "#34d399" },
      "500": { "$type": "color", "$value": "#10b981", "$description": "var(--p-primary-500) = cor primária" },
      "600": { "$type": "color", "$value": "#059669" },
      "700": { "$type": "color", "$value": "#047857" },
      "800": { "$type": "color", "$value": "#065f46" },
      "900": { "$type": "color", "$value": "#064e3b" },
      "950": { "$type": "color", "$value": "#022c22" }
    },
    "surface": {
      "$description": "Tema claro = slate; tema escuro = zinc. Variáveis --p-surface-0…950.",
      "0": { "$type": "color", "$value": "#ffffff" },
      "50": { "$type": "color", "$value": "#f8fafc" },
      "100": { "$type": "color", "$value": "#f1f5f9" },
      "200": { "$type": "color", "$value": "#e2e8f0" },
      "300": { "$type": "color", "$value": "#cbd5e1" },
      "400": { "$type": "color", "$value": "#94a3b8" },
      "500": { "$type": "color", "$value": "#64748b" },
      "600": { "$type": "color", "$value": "#475569" },
      "700": { "$type": "color", "$value": "#334155" },
      "800": { "$type": "color", "$value": "#1e293b" },
      "900": { "$type": "color", "$value": "#0f172a" },
      "950": { "$type": "color", "$value": "#020617" }
    },
    "severity": {
      "success": { "$type": "color", "$value": "#22c55e", "$description": "severity=\"success\" — ativo, concluído, aprovado" },
      "info": { "$type": "color", "$value": "#0ea5e9", "$description": "severity=\"info\" — informativo" },
      "warn": { "$type": "color", "$value": "#f97316", "$description": "severity=\"warn\" — pendente, atenção" },
      "danger": { "$type": "color", "$value": "#ef4444", "$description": "severity=\"danger\" — inativo, erro, exclusão" },
      "secondary": { "$type": "color", "$value": "#64748b", "$description": "severity=\"secondary\" — neutro" }
    }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Inter var", "Inter", "sans-serif"] },
    "root-size": { "$type": "dimension", "$value": "14px", "$description": "html { font-size } — base do rem" },
    "style": {
      "display": { "$type": "typography", "$value": { "fontSize": "2.5rem", "fontWeight": 800 } },
      "page-title": { "$type": "typography", "$value": { "fontSize": "1.5rem", "fontWeight": 700 }, "$description": ".ds-page-title" },
      "section-title": { "$type": "typography", "$value": { "fontSize": "1rem", "fontWeight": 700 }, "$description": ".ds-card-titulo" },
      "body": { "$type": "typography", "$value": { "fontSize": "1rem", "fontWeight": 400 } },
      "label": { "$type": "typography", "$value": { "fontSize": "0.8125rem", "fontWeight": 600 }, "$description": ".ds-campo label" },
      "description": { "$type": "typography", "$value": { "fontSize": "0.8125rem", "fontWeight": 400 }, "$description": "cor: --text-color-secondary" },
      "caption": { "$type": "typography", "$value": { "fontSize": "0.75rem", "fontWeight": 500 }, "$description": "cor: --text-color-secondary" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem", "$description": "entre botões" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem", "$description": "entre cards e entre campos" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem", "$description": "padding de página e de card" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "field-gap": { "$type": "dimension", "$value": "0.4rem", "$description": "rótulo → campo (.ds-campo)" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0" },
    "xs": { "$type": "dimension", "$value": "2px" },
    "sm": { "$type": "dimension", "$value": "4px", "$description": "tags, badges, checkbox" },
    "md": { "$type": "dimension", "$value": "6px", "$description": "botões, inputs (padrão PrimeNG)" },
    "lg": { "$type": "dimension", "$value": "8px", "$description": "menus, popovers" },
    "xl": { "$type": "dimension", "$value": "12px", "$description": "cards (.ds-card), modais" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "border": {
    "default": { "$type": "border", "$value": { "color": "{color.semantic.border}", "width": "1px", "style": "solid" } }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": "0 1px 4px rgba(0, 0, 0, 0.04)", "$description": "nível 1 — .ds-card" },
    "overlay": { "$type": "shadow", "$value": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)", "$description": "nível 2 — dropdowns, popovers" },
    "modal": { "$type": "shadow", "$value": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)", "$description": "nível 3 — dialogs, drawers" }
  },
  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "576px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "992px", "$description": "menu lateral fixo a partir daqui" },
    "xl": { "$type": "dimension", "$value": "1200px" },
    "2xl": { "$type": "dimension", "$value": "1920px" }
  },
  "layout": {
    "sidebar-width": { "$type": "dimension", "$value": "20rem" }
  },
  "icon": {
    "library": { "$type": "other", "$value": "PrimeIcons", "$description": "Classe: pi pi-<nome>" }
  }
}
